# Copy to .env and fill in. `docker compose` reads this automatically.

# Your domain — its DNS A record must point at this server's IP.
# Use "localhost" for local testing (Caddy issues a self-signed cert).
DOMAIN=heatclip.example.com

# Auth session signing secret. Generate one:  openssl rand -hex 32
# Keep it stable and private — changing it invalidates all sessions.
HEATCLIP_SECRET=

# Optional — enables AI hook detection (leave blank to use the heuristic).
ANTHROPIC_API_KEY=

# Security — restrict browser origins (comma-separated). Set to your domain in prod.
ALLOWED_ORIGINS=https://heatclip.example.com

# Owner/super-admin — pre-provisioned at startup so only the password holder can
# sign in as admin (and no one else can claim the email). SET A STRONG PASSWORD.
HEATCLIP_ADMIN_EMAIL=kumarlakshan1032@gmail.com
HEATCLIP_ADMIN_PASSWORD=

# Extra super-admin emails (comma-separated) with full access.
HEATCLIP_ADMINS=

# Optional privacy-friendly analytics (Plausible/Umami). Frontend build-time var —
# set before building the frontend image to enable. Leave blank to disable.
# NEXT_PUBLIC_ANALYTICS_DOMAIN=heatclip.duckdns.org
# NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
