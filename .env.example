# Copy to .env and fill in. `docker compose` reads this automatically.

# Your domain — its DNS A record must point at this server's IP.
# Use "localhost" for local testing (Caddy issues a self-signed cert).
DOMAIN=heatclip.example.com

# Auth session signing secret. Generate one:  openssl rand -hex 32
# Keep it stable and private — changing it invalidates all sessions.
HEATCLIP_SECRET=

# Optional — enables AI hook detection (leave blank to use the heuristic).
ANTHROPIC_API_KEY=
